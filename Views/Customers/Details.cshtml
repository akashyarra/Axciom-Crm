@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Profile";
    var auditLogs = ViewBag.AuditLogs as IEnumerable<AcxiomCRM.Models.AuditLog> ?? new List<AcxiomCRM.Models.AuditLog>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold text-dark mb-0">@Model.CustomerName</h4>
            <span class="badge bg-light text-primary border font-monospace">@Model.CustomerCode</span>
            <span class="badge-status @(Model.Status == "Active" ? "badge-active" : "badge-planned")">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Customer Profile & 360-Degree Lifecycle View</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-success">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-warning">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-light border text-muted btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Profile Card -->
    <div class="col-12 col-lg-4">
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-person-badge text-primary me-2"></i>Contact Information</span>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small">Company</label>
                    <div class="fw-semibold text-dark">@(Model.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Email</label>
                    <div><a href="mailto:@Model.Email" class="text-decoration-none"><i class="bi bi-envelope me-1"></i>@Model.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Phone</label>
                    <div class="fw-semibold text-dark"><i class="bi bi-telephone me-1 text-muted"></i>@Model.Phone</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Address</label>
                    <div class="text-dark">@(Model.Address ?? "-")</div>
                    <div class="text-muted small">@Model.City, @Model.State</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Assigned Sales Executive</label>
                    <div class="fw-semibold text-dark">@(Model.Owner?.FullName ?? "Unassigned")</div>
                </div>
                <div class="pt-2 border-top text-muted" style="font-size: 0.78rem;">
                    Created: @Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                </div>
            </div>
        </div>

        <!-- Audit History Box -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Recent Audit Events</span>
            </div>
            <div class="crm-card-body p-0">
                @if (auditLogs.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var log in auditLogs)
                        {
                            <li class="list-group-item p-3">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold text-primary">@log.Action</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">@log.Timestamp.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <div class="text-dark mt-1">@log.Details</div>
                                <div class="text-muted" style="font-size: 0.72rem;">By: @(log.UserName ?? "System")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No audit history found for this record.</div>
                }
            </div>
        </div>
    </div>

    <!-- Related CRM Data Tabs -->
    <div class="col-12 col-lg-8">
        <!-- Opportunities -->
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-graph-up-arrow text-success me-2"></i>Associated Opportunities (@Model.Opportunities.Count)</span>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-link text-decoration-none">
                    + Add Opportunity
                </a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.Opportunities.Any())
                {
                    <div class="table-responsive">
                        <table class="table crm-table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Opportunity Name</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                    <th>Probability</th>
                                    <th>Weighted</th>
                                    <th>Expected Close</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                                @opp.OpportunityName
                                            </a>
                                        </td>
                                        <td><span class="badge bg-secondary-subtle text-dark">@opp.Stage</span></td>
                                        <td class="fw-bold">$@opp.Amount.ToString("N0")</td>
                                        <td>@opp.Probability%</td>
                                        <td class="text-muted">$@opp.WeightedAmount.ToString("N0")</td>
                                        <td>@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No active opportunities linked to this customer.</div>
                }
            </div>
        </div>

        <!-- Follow-Ups -->
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-calendar2-check-fill text-warning me-2"></i>Scheduled Follow-Ups (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-link text-decoration-none">
                    + Schedule
                </a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table crm-table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark">@f.FollowUpType</span></td>
                                        <td>@f.Subject</td>
                                        <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge-status @(f.Status == "Completed" ? "badge-active" : "badge-planned")">@f.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No follow-ups recorded for this customer.</div>
                }
            </div>
        </div>

        <!-- Activities -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-clock-history text-info me-2"></i>Logged Activities (@Model.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-link text-decoration-none">
                    + Log Activity
                </a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.Activities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var a in Model.Activities)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between">
                                    <span class="badge bg-info-subtle text-info">@a.ActivityType</span>
                                    <span class="text-muted small">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</span>
                                </div>
                                <div class="fw-semibold text-dark mt-1">@a.Subject</div>
                                <div class="text-muted small">@(a.Description ?? "")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No activities logged yet.</div>
                }
            </div>
        </div>
    </div>
</div>
