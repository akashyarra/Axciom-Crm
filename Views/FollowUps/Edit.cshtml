@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">Edit / Reschedule Follow-Up</h4>
                <p class="text-muted small mb-0">Modify follow-up details, date, status, or remarks.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="crm-card">
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email Communication</option>
                                <option value="Task">Action Task</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="FollowUpDate" class="form-control" type="date" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="CustomerId" class="form-label fw-semibold text-dark small">Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="LeadId" class="form-label fw-semibold text-dark small">Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="OpportunityId" class="form-label fw-semibold text-dark small">Opportunity</label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.OpportunityId">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold text-dark small">Assigned Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-muted">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Update Follow-Up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
