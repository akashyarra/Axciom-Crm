@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Edit Lead";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">Edit Lead: @Model.LeadName</h4>
                <p class="text-muted small mb-0">Update qualification notes, priority, or status.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Leads
            </a>
        </div>

        <div class="crm-card">
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="ConvertedCustomerId" />
                    <input type="hidden" asp-for="ConvertedOpportunityId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="LeadCode" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="LeadCode" class="form-control" readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website Inbound</option>
                                <option value="Referral">Client Referral</option>
                                <option value="Social Media">Social Media</option>
                                <option value="Cold Call">Cold Outreach</option>
                                <option value="Exhibition">Trade Show / Exhibition</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Converted">Converted</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="100" min="0" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="AssignedTo" class="form-label fw-semibold text-dark small">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-muted">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Update Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
