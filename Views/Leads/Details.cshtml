@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Details";
    var auditLogs = ViewBag.AuditLogs as IEnumerable<AcxiomCRM.Models.AuditLog> ?? new List<AcxiomCRM.Models.AuditLog>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold text-dark mb-0">@Model.LeadName</h4>
            <span class="badge bg-light text-primary border font-monospace">@Model.LeadCode</span>
            <span class="badge-status @(Model.Status == "New" ? "badge-new" : Model.Status == "Contacted" ? "badge-contacted" : Model.Status == "Qualified" ? "badge-qualified" : Model.Status == "Converted" ? "badge-converted" : Model.Status == "Lost" ? "badge-lost" : "badge-planned")">
                @Model.Status
            </span>
        </div>
        <p class="text-muted small mb-0 mt-1">Lead Capture & Qualification Record</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer/Opportunity
            </a>
        }
        else
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="btn btn-outline-success btn-sm">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-light border text-muted btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-5">
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Lead Overview</span>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small">Company</label>
                    <div class="fw-semibold text-dark">@(Model.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Email Address</label>
                    <div><a href="mailto:@Model.Email" class="text-decoration-none"><i class="bi bi-envelope me-1"></i>@Model.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Phone Number</label>
                    <div class="fw-semibold text-dark"><i class="bi bi-telephone me-1 text-muted"></i>@Model.Phone</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Lead Source</label>
                    <div><span class="badge bg-light text-dark border">@Model.Source</span></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Priority</label>
                    <div class="fw-semibold">
                        @if (Model.Priority == "High") { <span class="text-danger"><i class="bi bi-arrow-up-circle-fill me-1"></i>High</span> }
                        else if (Model.Priority == "Medium") { <span class="text-warning"><i class="bi bi-dash-circle-fill me-1"></i>Medium</span> }
                        else { <span class="text-muted"><i class="bi bi-arrow-down-circle-fill me-1"></i>Low</span> }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Expected Deal Value</label>
                    <div class="fs-5 fw-bold text-success">$@Model.ExpectedValue.ToString("N0")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Assigned Sales Executive</label>
                    <div class="fw-semibold text-dark">@(Model.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mb-3">
                        <label class="text-muted small">Notes & Context</label>
                        <div class="p-2 bg-light rounded text-dark small">@Model.Notes</div>
                    </div>
                }
                <div class="pt-2 border-top text-muted" style="font-size: 0.78rem;">
                    Created: @Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                </div>
            </div>
        </div>

        <!-- Audit History -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Audit Events</span>
            </div>
            <div class="crm-card-body p-0">
                @if (auditLogs.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var log in auditLogs)
                        {
                            <li class="list-group-item p-3">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold text-primary">@log.Action</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">@log.Timestamp.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <div class="text-dark mt-1">@log.Details</div>
                                <div class="text-muted" style="font-size: 0.72rem;">By: @(log.UserName ?? "System")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-3 text-center text-muted small">No audit history recorded.</div>
                }
            </div>
        </div>
    </div>

    <!-- Related Follow-ups & Activities -->
    <div class="col-12 col-lg-7">
        <!-- Follow-Ups -->
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-calendar2-check-fill text-warning me-2"></i>Follow-Ups (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">+ Schedule</a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table crm-table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark">@f.FollowUpType</span></td>
                                        <td>@f.Subject</td>
                                        <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge-status @(f.Status == "Completed" ? "badge-active" : "badge-planned")">@f.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No follow-ups recorded for this lead.</div>
                }
            </div>
        </div>

        <!-- Activities -->
        <div class="crm-card">
            <div class="crm-card-header">
                <span class="fw-bold text-dark"><i class="bi bi-clock-history text-info me-2"></i>Logged Activities (@Model.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">+ Log Activity</a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.Activities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var a in Model.Activities)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between">
                                    <span class="badge bg-info-subtle text-info">@a.ActivityType</span>
                                    <span class="text-muted small">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</span>
                                </div>
                                <div class="fw-semibold text-dark mt-1">@a.Subject</div>
                                <div class="text-muted small">@(a.Description ?? "")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No activities logged for this lead.</div>
                }
            </div>
        </div>
    </div>
</div>
