@model AcxiomCRM.ViewModels.LeadConversionViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1"><i class="bi bi-arrow-repeat text-success me-2"></i>Convert Lead to Customer</h4>
                <p class="text-muted small mb-0">Qualify prospect and promote into active Customer and Sales Opportunity.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
        </div>

        <div class="crm-card">
            <div class="crm-card-body">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0"></div>

                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <h6 class="fw-bold text-dark mb-2">Customer Profile to Create:</h6>
                        <div class="row g-2 text-muted small">
                            <div class="col-sm-6"><strong>Name:</strong> @Model.LeadName</div>
                            <div class="col-sm-6"><strong>Company:</strong> @(Model.CompanyName ?? "N/A")</div>
                            <div class="col-sm-6"><strong>Email:</strong> @Model.Email</div>
                            <div class="col-sm-6"><strong>Phone:</strong> @Model.Phone</div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="chkCreateOpp" checked onchange="toggleOppFields()">
                        <label class="form-check-label fw-semibold text-dark" for="chkCreateOpp">
                            Create Sales Opportunity for this Customer
                        </label>
                    </div>

                    <div id="oppSection" class="p-3 border rounded-3 bg-white mb-3">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-graph-up me-1"></i>Opportunity Details</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="OpportunityName" class="form-label fw-semibold text-dark small"></label>
                                <input asp-for="OpportunityName" class="form-control" />
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold text-dark small"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="100" min="1" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold text-dark small"></label>
                                <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light border text-muted">Cancel</a>
                        <button type="submit" class="btn btn-success fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleOppFields() {
            var checked = document.getElementById('chkCreateOpp').checked;
            document.getElementById('oppSection').style.display = checked ? 'block' : 'none';
        }
    </script>
}
