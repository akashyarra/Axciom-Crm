@model AcxiomCRM.ViewModels.UserManagementIndexViewModel
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-shield-lock-fill text-primary me-2"></i>User & Role Administration</h4>
        <p class="text-muted small mb-0">Manage enterprise user accounts, assign primary roles, manage lockouts, and reset credentials.</p>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by user name or email..." />
            </div>
        </div>
        <div class="col-12 col-md-4">
            <select name="roleFilter" class="form-select">
                <option value="">All Roles</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                <option value="SalesExecutive" selected="@(Model.RoleFilter == "SalesExecutive")">Sales Executive</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a asp-action="Index" class="btn btn-light border text-muted">Clear</a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table table-hover">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Lockout State</th>
                    <th>Failed Logins</th>
                    <th>Created</th>
                    <th class="text-end">Administrative Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold text-dark">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 32px; height: 32px; border-radius: 50%; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                                    @(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "U")
                                </div>
                                @u.FullName
                            </div>
                        </td>
                        <td><a href="mailto:@u.Email" class="text-muted text-decoration-none">@u.Email</a></td>
                        <td>
                            <span class="badge @(u.Role == "Admin" ? "bg-danger-subtle text-danger" : u.Role == "Manager" ? "bg-warning-subtle text-warning-emphasis" : "bg-primary-subtle text-primary")">
                                @u.Role
                            </span>
                        </td>
                        <td>
                            <span class="badge-status @(u.IsActive ? "badge-active" : "badge-lost")">
                                @(u.IsActive ? "Active" : "Deactivated")
                            </span>
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-lock-fill me-1"></i> Locked Out
                                </span>
                            }
                            else
                            {
                                <span class="text-success small fw-semibold">
                                    <i class="bi bi-unlock-fill me-1"></i> Normal
                                </span>
                            }
                        </td>
                        <td>@u.FailedLoginCount</td>
                        <td class="text-muted small">@u.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit Role & Details">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Reset Password">
                                    <i class="bi bi-key"></i> Reset Pwd
                                </a>

                                @if (u.IsLockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                            <i class="bi bi-unlock"></i> Unlock
                                        </button>
                                    </form>
                                }

                                <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
