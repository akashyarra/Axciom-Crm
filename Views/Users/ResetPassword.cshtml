@model AcxiomCRM.ViewModels.ResetPasswordAdminViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1"><i class="bi bi-key-fill text-primary me-2"></i>Reset User Password</h4>
                <p class="text-muted small mb-0">Set a new compliant password for @Model.UserName.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>

        <div class="crm-card">
            <div class="crm-card-body">
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Target User</label>
                        <input value="@Model.UserName" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                        <div class="text-muted small" style="font-size: 0.78rem;">
                            Minimum 8 chars with uppercase, lowercase, digit, and special symbol.
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-muted">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-shield-lock me-1"></i> Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
