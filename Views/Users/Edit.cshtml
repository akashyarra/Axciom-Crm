@model AcxiomCRM.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    var roles = ViewBag.AvailableRoles as string[] ?? new[] { "Admin", "Manager", "SalesExecutive" };
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">Edit User Account</h4>
                <p class="text-muted small mb-0">Modify user profile, active state, and assigned primary role.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>

        <div class="crm-card">
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Email Address</label>
                        <input value="@Model.Email" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold text-dark small">Primary Role</label>
                        <select asp-for="Role" class="form-select">
                            @foreach (var r in roles)
                            {
                                <option value="@r" selected="@(Model.Role == r)">@r</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="chkActive">
                        <label class="form-check-label fw-semibold text-dark" for="chkActive">
                            Account Active (can authenticate and perform CRM duties)
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-muted">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
