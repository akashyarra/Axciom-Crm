@{
    ViewData["Title"] = "Account Locked";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Locked - AcxiomCRM</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .card {
            max-width: 460px;
            border-radius: 16px;
            padding: 32px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="card shadow-lg border-0 bg-white">
        <div class="text-danger mb-3" style="font-size: 3rem;">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h3 class="fw-bold text-dark">Account Locked</h3>
        <p class="text-muted mt-2">
            This account has been temporarily locked out due to multiple failed authentication attempts in accordance with AcxiomCRM security policy.
        </p>
        <p class="text-muted small">
            Please wait 15 minutes before trying again or contact your System Administrator to unlock your account immediately.
        </p>
        <div class="mt-4">
            <a href="/Account/Login" class="btn btn-primary px-4 py-2 fw-semibold">Back to Login</a>
        </div>
    </div>
</body>
</html>
