@model AcxiomCRM.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account - AcxiomCRM</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .register-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
            max-width: 520px;
            width: 100%;
            overflow: hidden;
        }
        .register-header {
            padding: 32px 36px 16px;
            text-align: center;
        }
        .register-body {
            padding: 0 36px 36px;
        }
        .form-control, .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 0.92rem;
            border: 1px solid #cbd5e1;
        }
        .btn-register {
            background: #2563eb;
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 12px;
            border-radius: 10px;
            width: 100%;
            transition: all 0.2s;
        }
        .btn-register:hover {
            background: #1d4ed8;
        }
        .password-hint {
            font-size: 0.78rem;
            color: #64748b;
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="register-header">
            <h4 class="fw-bold text-dark mb-1">Create AcxiomCRM Account</h4>
            <p class="text-muted small">Register as an enterprise user</p>
        </div>

        <div class="register-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small border-0" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold text-dark small"></label>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-dark small"></label>
                    <input asp-for="Email" class="form-control" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold text-dark small"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="SalesExecutive">Sales Executive (Standard)</option>
                        <option value="Manager">Sales Manager</option>
                        <option value="Admin">Administrator</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold text-dark small"></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <div class="password-hint">Min 8 chars with uppercase, lowercase, number, and special character.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-register">
                    <i class="bi bi-person-plus-fill me-1"></i> Register Account
                </button>
            </form>

            <div class="text-center mt-3 text-muted small">
                Already registered? <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Sign In</a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
