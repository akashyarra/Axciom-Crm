@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-1">Sales Opportunities & Pipeline</h4>
        <p class="text-muted small mb-0">Manage deals across stages (Qualification, Proposal, Negotiation, Won, Lost).</p>
    </div>
    <a asp-action="Create" class="btn btn-crm-primary">
        <i class="bi bi-plus-circle me-1"></i> New Opportunity
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search opportunity or customer..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="stage" class="form-select">
                <option value="">All Stages</option>
                <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a asp-action="Index" class="btn btn-light border text-muted">Clear</a>
        </div>
    </form>
</div>

<!-- Opportunity Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table table-hover">
            <thead>
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Stage</th>
                    <th>Amount</th>
                    <th>Prob.</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none text-dark">
                                    @item.OpportunityName
                                </a>
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">
                                        @item.Customer.CustomerName
                                    </a>
                                }
                                else if (item.Lead != null)
                                {
                                    <span class="text-muted">Lead: @item.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.Stage == "Won" ? "bg-success" : item.Stage == "Lost" ? "bg-danger" : item.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary-subtle text-primary")">
                                    @item.Stage
                                </span>
                            </td>
                            <td class="fw-bold text-dark">$@item.Amount.ToString("N0")</td>
                            <td>@item.Probability%</td>
                            <td class="text-muted fw-semibold">$@item.WeightedAmount.ToString("N0")</td>
                            <td>
                                <span class="@(item.ExpectedCloseDate.Date < DateTime.Today && item.Status == "Open" ? "text-danger fw-bold" : "")">
                                    @item.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                </span>
                            </td>
                            <td>@(item.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delOppModal-@item.OpportunityId" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="delOppModal-@item.OpportunityId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title fw-bold">Delete Opportunity</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body py-2">
                                                Are you sure you want to delete opportunity <strong>@item.OpportunityName</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-graph-up fs-1 text-secondary"></i>
                            <div class="mt-2">No opportunities found matching your filters.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <span class="text-muted small">Showing @Model.Count() of @ViewBag.TotalCount opportunities</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-stage="@ViewBag.Stage" asp-route-status="@ViewBag.Status">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
