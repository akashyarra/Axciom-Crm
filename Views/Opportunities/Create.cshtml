@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">Create Opportunity</h4>
                <p class="text-muted small mb-0">Track a new deal with amount, probability, and expected close date.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Pipeline
            </a>
        </div>

        <div class="crm-card">
            <div class="crm-card-body">
                <form asp-action="Create" method="post" id="createOppForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud License Deal" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold text-dark small">Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                                <option value="">-- Select Customer (Optional if Lead) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold text-dark small">Associated Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                                <option value="">-- Select Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Amount" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" type="number" step="100" min="0.01" id="oppAmount" />
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem;">Must be greater than 0.</div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Probability" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" id="oppProb" />
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem;">Between 0 and 100 inclusive.</div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Stage" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification (20%)</option>
                                <option value="Proposal">Proposal (50%)</option>
                                <option value="Negotiation">Negotiation (80%)</option>
                                <option value="Won">Won (100%)</option>
                                <option value="Lost">Lost (0%)</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" id="oppCloseDate" />
                            <div class="text-muted" style="font-size: 0.75rem;">Cannot be in the past for active deals.</div>
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Source" class="form-control" placeholder="Direct, Referral, Website..." />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold text-dark small">Deal Owner</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Strategic notes, competitors, proposal version..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-muted">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-save me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
